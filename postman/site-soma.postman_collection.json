{
  "info": {
    "name": "site-soma - Operacoes POST",
    "description": "Testes Postman das quatro operacoes matematicas do servidor Express.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Soma",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"a\": 7,\n  \"b\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/soma",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "3001",
          "path": [ "soma" ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Resultado da soma', function () { pm.expect(pm.response.text()).to.eql('O resultado da soma de 7 e 5 é 12'); });"
            ]
          }
        }
      ]
    },
    {
